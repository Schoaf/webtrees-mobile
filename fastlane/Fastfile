# Store texts, screenshots and submission - run by .github/workflows/store.yml
# on a release tag. Texts: fastlane/metadata (the App Store review contact and
# demo account stay as they are in App Store Connect - never put them here,
# the repo is public). Screenshots: copied by tool/prepare_store_uploads.py
# from screenshots/store, not committed.

# Submits the TestFlight build [build] as version [version] for review, with
# the texts and screenshots.
lane :store_ios do |options|
  api_key = app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY"),
  )
  deliver(
    api_key: api_key,
    app_version: options[:version],
    build_number: options[:build],
    metadata_path: "./fastlane/metadata/ios",
    screenshots_path: "./fastlane/screenshots/ios",
    overwrite_screenshots: true,
    skip_binary_upload: true,
    submit_for_review: true,
    force: true,
    run_precheck_before_submit: false,
    submission_information: { add_id_info_uses_idfa: false },
  )
end

# Promotes the internal-testing build [build] to production, with the texts,
# screenshots and release notes.
lane :store_android do |options|
  supply(
    json_key_data: ENV.fetch("PLAY_JSON"),
    track: "internal",
    track_promote_to: "production",
    version_code: options[:build].to_i,
    metadata_path: "./fastlane/metadata/android",
    skip_upload_apk: true,
    skip_upload_aab: true,
  )
end
