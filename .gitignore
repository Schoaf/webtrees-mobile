# Generated by `flutter gen-l10n` (see l10n.yaml) - regenerated automatically
# by `flutter pub get` since pubspec.yaml has `generate: true`. Only the
# hand-authored lib/l10n/*.arb source files are checked in.
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated by test/screenshots/store_screenshots_test.dart (stage 1) and
# tool/compose_store_screenshots.py (stage 2) - regenerate on demand, don't
# commit store screenshot assets.
/screenshots/raw/
/screenshots/store/
